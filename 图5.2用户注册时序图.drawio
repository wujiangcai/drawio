<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="user-register-sequence-diagram" name="用户注册时序图">
    <mxGraphModel dx="1460" dy="943" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="用户注册时序图" vertex="1">
          <mxGeometry height="30" width="300" x="434" y="20" as="geometry" />
        </mxCell>
        <mxCell id="frontend" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;startSize=30;" value="前端（Register.vue）" vertex="1">
          <mxGeometry height="360" width="1120" x="20" y="70" as="geometry" />
        </mxCell>
        <mxCell id="backend" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontSize=13;fontStyle=1;startSize=30;" value="后端（FrontAuthController、UserServiceImpl）" vertex="1">
          <mxGeometry height="360" width="1120" x="20" y="450" as="geometry" />
        </mxCell>
        <mxCell id="frontendInput" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="用户填写注册信息（用户名、密码、确认密码、手机号、昵称、邮箱）" vertex="1">
          <mxGeometry height="60" width="180" x="200" y="120" as="geometry" />
        </mxCell>
        <mxCell id="frontendValidate" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="前端校验（格式验证）" vertex="1">
          <mxGeometry height="60" width="180" x="400" y="120" as="geometry" />
        </mxCell>
        <mxCell id="frontendValidatePass" edge="1" parent="1" source="frontendValidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;" target="sendRequest" value="格式校验通过">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="frontendValidateFail" edge="1" parent="1" source="frontendValidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;" value="格式校验失败">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sendRequest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="发送 POST 请求到 /api/front/auth/register" vertex="1">
          <mxGeometry height="60" width="180" x="600" y="120" as="geometry" />
        </mxCell>
        <mxCell id="backendReceive" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="FrontAuthController 接收请求" vertex="1">
          <mxGeometry height="60" width="180" x="600" y="450" as="geometry" />
        </mxCell>
        <mxCell id="paramValidate" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="参数校验（RegisterRequest 注解）" vertex="1">
          <mxGeometry height="60" width="180" x="800" y="450" as="geometry" />
        </mxCell>
        <mxCell id="paramValidatePass" edge="1" parent="1" source="paramValidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;" target="checkDuplicate" value="校验通过">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="paramValidateFail" edge="1" parent="1" source="paramValidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;" value="校验失败">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="checkDuplicate" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="校验用户名和手机号是否重复" vertex="1">
          <mxGeometry height="60" width="180" x="1000" y="450" as="geometry" />
        </mxCell>
        <mxCell id="duplicateCheckPass" edge="1" parent="1" source="checkDuplicate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;" target="encryptPassword" value="校验通过">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="duplicateCheckFail" edge="1" parent="1" source="checkDuplicate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;" value="重复错误">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="encryptPassword" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="PasswordEncoder 加密密码" vertex="1">
          <mxGeometry height="60" width="180" x="1200" y="450" as="geometry" />
        </mxCell>
        <mxCell id="writeDatabase" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="UserMapper 写入数据库" vertex="1">
          <mxGeometry height="60" width="180" x="1200" y="550" as="geometry" />
        </mxCell>
        <mxCell id="returnResult" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="返回认证结果（token、userId、username、role）" vertex="1">
          <mxGeometry height="60" width="220" x="1400" y="650" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" value="结束" vertex="1">
          <mxGeometry height="40" width="100" x="1440" y="740" as="geometry" />
        </mxCell>
        <mxCell id="arrows" edge="1" parent="1" source="sendRequest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;" target="backendReceive" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
