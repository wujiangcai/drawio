        <mxCell id="skipCf" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=SimSun;fontSize=13;align=center;verticalAlign=middle;" value="游客无登录身份和历史行为数据，跳过协同过滤" vertex="1">
